# GEMINI_API_KEY: Required for Gemini AI API calls (audio transcription & viral moment detection).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional PostgreSQL connection string for production deployments.
# Falls back to local SQLite (./storage/clipforge.db) when empty.
DATABASE_URL=""

# S3_BUCKET: Optional S3-compatible bucket name for remote media storage.
# Falls back to local filesystem storage (./storage/) when empty.
S3_BUCKET=""

# S3_ENDPOINT: Optional S3-compatible endpoint URL (AWS S3, Cloudflare R2, MinIO).
# Falls back to local filesystem storage (./storage/) when empty.
S3_ENDPOINT=""
