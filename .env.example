# =============================================================================
# REQUIRED FOR AI PROCESSING (Stages 1 & 2: Transcription + Viral Moment AI)
# =============================================================================
# Obtain a real key from Google AI Studio: https://aistudio.google.com/apikey
# Note: The server starts cleanly even without this key; it is only needed
# when running AI speech transcription and viral moment detection.
GEMINI_API_KEY=

# =============================================================================
# OPTIONAL RUNTIME SETTINGS (Zero-config local defaults work out of the box)
# =============================================================================
# APP_URL: Public URL where the app is hosted (optional in local dev).
# APP_URL=http://localhost:3000

# DATABASE_URL: Optional PostgreSQL connection string for multi-instance production
# deployments (schema in db/schema.sql). Omitted by default — ClipForge AI
# automatically uses local SQLite at ./storage/clipforge.db with no setup.
# DATABASE_URL=postgresql://clipforge:clipforge@localhost:5432/clipforge

# MEDIA_INGEST / MEDIA_INGEST_CMD: Optional path to an authorized downloader
# binary (e.g. yt-dlp) for YouTube/TikTok/Twitch links. Not required for direct
# MP4/MOV/WebM uploads, direct .mp4 HTTP URLs, or built-in sample videos.
# MEDIA_INGEST=yt-dlp

# S3_BUCKET / S3_ENDPOINT: Optional S3-compatible object storage configuration
# (AWS S3, Cloudflare R2, MinIO) for external archival. Omitted by default —
# ClipForge AI stores uploads, thumbnails, and MP4 Shorts locally in ./storage/.
# S3_BUCKET=
# S3_ENDPOINT=
